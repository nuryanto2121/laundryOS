# Go API — Environment Variables
# These values are injected by Docker Compose from the root .env file.
# When running locally (make api), create a local .env and source it,
# or export variables manually.

PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laundryos
DB_USER=postgres
DB_PASSWORD=secret
REDIS_HOST=localhost
REDIS_PORT=6379
APP_VERSION=0.1.0
